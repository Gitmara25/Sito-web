---
import Favicon from "./components/Favicon.astro";
import MetadataSEO from "./components/MetadataSEO.astro";
import Header from "./components/Header.tsx";
import Footer from "./components/Footer.astro";

import type { MetadescriptionType } from "../types/types";
interface Props {
  metadescription: MetadescriptionType;
}
const { metadescription } = Astro.props;

//Import CSS
import "../assets/css/main.css";
---

<!doctype html>
<html lang='it'>
  <head>
    <script
      type='text/javascript'
      src='https://embeds.iubenda.com/widgets/d911dfed-4e39-44b8-abdf-3278c50b6875.js'
    ></script>
    <Favicon />
    <MetadataSEO metadescription={metadescription} />
    <title>Mara Arredamenti</title>
  </head>
  <body>
    <Header client:load />
    <slot />
    <Footer />
  </body>
</html>
