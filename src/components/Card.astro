<a href={to}>
  <div
    class='rounded-mara max-h-[30rem] aspect-square group overflow-hidden flex flex-col justify-end relative'
  >
    <img
      class='rounded-mara transition-transform duration-300 group-hover:scale-110 -z-1 brightness-65 absolute top-0 object-cover w-full h-full'
      loading='lazy'
      src=`/images/${img}`
      alt={img}
    />
    <p class='font-ibmplex-m ml-4'>{title}</p>
    <p class='ml-4 mb-8'>{subtitle}</p>
  </div>
</a>
